<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Binaire" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/panel_solid</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/red</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:defaultFocusHighlightEnabled" tools:targetApi="o">false</item>
    </style>

    <style name="Theme.Binaire.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="T" />
    <style name="T.Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/outfit_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="T.Body">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="T.Muted">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Input">
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/faint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
