<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:background="@drawable/panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="26dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo" />

            <TextView
                style="@style/T.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                android:text="Connecte ton abonnement (Xtream Codes)"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etServer"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_marginBottom="10dp"
                android:hint="Serveur (ex : http://exemple.com:8080)"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/etUser"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_marginBottom="10dp"
                android:hint="Nom d'utilisateur"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/etPass"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_marginBottom="16dp"
                android:hint="Mot de passe"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/cbShowPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:text="Afficher le mot de passe"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLogin"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Se connecter"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAccount"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="Utiliser mon compte Binaire (QR code)" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#FF8A98"
                android:textSize="13sp" />

            <TextView
                style="@style/T.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Astuce : colle ton lien M3U complet dans « Serveur », les champs se remplissent tout seuls." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
