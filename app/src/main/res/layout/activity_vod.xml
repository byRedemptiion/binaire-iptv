<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/heroBg"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/grad_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="200dp"
        android:background="@drawable/grad_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="20dp"
        android:paddingEnd="0dp">

        <include
            layout="@layout/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingEnd="32dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/heroBox"
            android:layout_width="460dp"
            android:layout_height="132dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/heroTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:textColor="#FF8A98"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_extrabold"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/heroPlot"
                style="@style/T.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/tvEmpty"
                style="@style/T.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/suggest_box" />
</FrameLayout>
